# Server Configuration
NODE_ENV=development
PORT=9091

# Database Configuration
# For local development: Leave DATABASE_URL empty to use SQLite
# For Coze deployment: Set DATABASE_URL to your PostgreSQL connection string
# Example: DATABASE_URL=postgresql://user:password@host:5432/dbname

# Coze API Configuration (if using AI features)
COZE_API_KEY=your_api_key_here